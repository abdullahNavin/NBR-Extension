{
  "manifest_version": 3,
  "name": "NBR Auto Sum",
  "version": "3.2.0",
  "description": "Automatically sums Fund+Net Wealth and Living Expenditure on the NBR e-Tax portal (office.etaxnbr.gov.bd).",
  "permissions": [
    "tabs",
    "scripting",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://office.etaxnbr.gov.bd/*",
    "http://localhost:3000/*"
  ],
  "oauth2": {
    "client_id": "184547006638-qtm8a719vdqe31b21mqc8mqmmjn8b8pk.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://office.etaxnbr.gov.bd/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nbr_logo.png",
      "48": "icons/nbr_logo.png",
      "128": "icons/nbr_logo.png"
    }
  },
  "icons": {
    "16": "icons/nbr_logo.png",
    "48": "icons/nbr_logo.png",
    "128": "icons/nbr_logo.png"
  }
}
